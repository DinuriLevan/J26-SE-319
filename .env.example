# Copy this file to .env in the repo root before running `docker compose up`.
# docker-compose.yml reads these values for the db and backend services.

# --- Postgres (db service) ---
# Exposed on host port 5433 (not 5432) to avoid clashing with another local Postgres.
POSTGRES_USER=akurin
POSTGRES_PASSWORD=akurin_dev_password
POSTGRES_DB=akurin

# --- Backend (backend service) ---
# Must match the Postgres values above; "db" is the compose service name, resolved via Docker's internal network.
DATABASE_URL=postgresql://akurin:akurin_dev_password@db:5432/akurin
CORS_ORIGINS=*
APP_ENV=development

# --- Flutter app (not read by docker compose, documented here for convenience) ---
# Pass this as a --dart-define when running the Flutter app, e.g.:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000   (Android emulator -> host loopback)
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.23:8000  (physical device -> host LAN IP)
API_BASE_URL=http://10.0.2.2:8000
