# This file is NOT read automatically by the app (we use --dart-define, see README.md).
# It documents the one variable you need to pass at run time:
#
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
#
# Use http://10.0.2.2:8000 for the Android emulator, or your machine's LAN IP
# (e.g. http://192.168.1.23:8000) for a physical device on the same network.
API_BASE_URL=http://10.0.2.2:8000
